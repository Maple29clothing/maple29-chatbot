# Copy to .env (local runs) or set as environment variables on your host.
# NEVER commit real tokens to git.

# Must match the Verify Token you type in the Meta app dashboard.
VERIFY_TOKEN=choose-a-long-random-string

# Page access token: Meta app -> Messenger -> Access tokens -> generate for the
# Maple-29 Page.
PAGE_ACCESS_TOKEN=

# Loyverse personal access token: Loyverse Back Office -> Integrations ->
# +Add Access Token. Sent as a Bearer header; used only for price/size/color
# lookups. The bot never reads or states inventory levels.
LOYVERSE_TOKEN=

PORT=8080
# Where order/team handoffs are appended (JSONL, one object per line).
HANDOFF_LOG=handoffs.jsonl
# Seconds the Loyverse catalog stays cached in memory.
CATALOG_TTL_SECONDS=900
